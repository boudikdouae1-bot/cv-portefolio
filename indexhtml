<DOCTYPE html>TYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CV Digital - Étudiant en Marketing</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap');
        
        body {
            font-family: 'Inter', sans-serif;
            scroll-behavior: smooth;
        }

        .gradient-text {
            background: linear-gradient(90deg, #2563eb, #7c3aed);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .skill-card:hover {
            transform: translateY(-5px);
            transition: all 0.3s ease;
        }

        .glass-morphism {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-900">

    <!-- Navigation -->
    <nav class="fixed w-full z-50 glass-morphism shadow-sm">
        <div class="max-w-6xl mx-auto px-6 py-4 flex justify-between items-center">
            <span class="text-xl font-bold gradient-text">Yasmine Alaoui</span>
            <div class="hidden md:flex space-x-8 font-medium">
                <a href="#accueil" class="hover:text-blue-600 transition">Accueil</a>
                <a href="#parcours" class="hover:text-blue-600 transition">Parcours</a>
                <a href="#competences" class="hover:text-blue-600 transition">Compétences</a>
                <a href="#contact" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition">Contact</a>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section id="accueil" class="pt-32 pb-20 px-6">
        <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center gap-12">
            <div class="flex-1 text-center md:text-left">
                <span class="inline-block px-4 py-1 bg-blue-100 text-blue-700 rounded-full text-sm font-semibold mb-4">Recherche de Stage - Rabat</span>
                <h1 class="text-4xl md:text-6xl font-extrabold mb-6 leading-tight">
                    Futur Marketeur Digital <br><span class="gradient-text">Passionnée & Créative</span>
                </h1>
                <p class="text-lg text-slate-600 mb-8 max-w-xl">
                    Étudiante en 2ème année de Marketing à l'ENCG, je recherche un stage de 2 mois à Rabat pour mettre mes compétences en Social Media et SEO au service de votre croissance.
                </p>
                <div class="flex flex-wrap justify-center md:justify-start gap-4">
                    <a href="#contact" class="px-8 py-3 bg-blue-600 text-white font-bold rounded-xl shadow-lg hover:shadow-blue-200 transition">Me recruter</a>
                    <button onclick="window.print()" class="px-8 py-3 bg-white border border-slate-200 font-bold rounded-xl hover:bg-slate-50 transition">Télécharger PDF</button>
                </div>
            </div>
            <div class="flex-1 flex justify-center">
                <div class="relative w-64 h-64 md:w-80 md:h-80">
                    <div class="absolute inset-0 bg-blue-600 rounded-3xl rotate-6 opacity-20"></div>
                    <div class="absolute inset-0 bg-slate-200 rounded-3xl overflow-hidden shadow-2xl">
                        <img src="https://images.unsplash.com/photo-1573497019940-1c28c88b4f3e?auto=format&fit=crop&q=80&w=400" alt="Yasmine Alaoui" class="w-full h-full object-cover">
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Expériences & Éducation -->
    <section id="parcours" class="py-20 bg-white">
        <div class="max-w-4xl mx-auto px-6">
            <h2 class="text-3xl font-bold mb-12 text-center underline decoration-blue-500 decoration-4 underline-offset-8">Mon Parcours</h2>
            
            <div class="space-y-12">
                <!-- Éducation -->
                <div class="relative pl-8 border-l-2 border-slate-100">
                    <div class="absolute w-4 h-4 bg-blue-600 rounded-full -left-[9px] top-1"></div>
                    <span class="text-blue-600 font-bold text-sm">2023 - Présent</span>
                    <h3 class="text-xl font-bold mt-1">Diplôme de l'ENCG (2ème année)</h3>
                    <p class="text-slate-500">Rabat, Maroc</p>
                    <p class="mt-2 text-slate-600">Spécialisation progressive en Marketing et Communication. Major de promotion en Marketing Fondamental.</p>
                </div>

                <!-- Expérience -->
                <div class="relative pl-8 border-l-2 border-slate-100">
                    <div class="absolute w-4 h-4 bg-purple-600 rounded-full -left-[9px] top-1"></div>
                    <span class="text-purple-600 font-bold text-sm">Juin - Juillet 2024</span>
                    <h3 class="text-xl font-bold mt-1">Stage d'observation - Agence Com'Digital</h3>
                    <p class="text-slate-500">Rabat / Casablanca</p>
                    <ul class="mt-3 list-disc list-inside text-slate-600 space-y-2">
                        <li>Aide à la gestion des calendriers éditoriaux pour 3 clients.</li>
                        <li>Analyse des indicateurs de performance (KPI) sur Instagram et LinkedIn.</li>
                        <li>Veille concurrentielle sur les tendances du marché marocain.</li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- Compétences -->
    <section id="competences" class="py-20 bg-slate-50">
        <div class="max-w-6xl mx-auto px-6 text-center">
            <h2 class="text-3xl font-bold mb-16 underline decoration-blue-500 decoration-4 underline-offset-8">Expertises Techniques</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="skill-card p-8 bg-white rounded-2xl shadow-sm">
                    <div class="w-14 h-14 bg-blue-100 text-blue-600 rounded-xl flex items-center justify-center mx-auto mb-6 text-2xl">
                        <i class="fas fa-bullhorn"></i>
                    </div>
                    <h3 class="text-xl font-bold mb-4">Social Media</h3>
                    <p class="text-slate-500 text-sm">Content planning, Meta Business Suite, Canva Pro, CapCut (montage Reels).</p>
                </div>

                <div class="skill-card p-8 bg-white rounded-2xl shadow-sm">
                    <div class="w-14 h-14 bg-purple-100 text-purple-600 rounded-xl flex items-center justify-center mx-auto mb-6 text-2xl">
                        <i class="fas fa-search-dollar"></i>
                    </div>
                    <h3 class="text-xl font-bold mb-4">SEO & Analytics</h3>
                    <p class="text-slate-500 text-sm">Notions de Google Analytics 4, recherche de mots-clés, rédaction web optimisée.</p>
                </div>

                <div class="skill-card p-8 bg-white rounded-2xl shadow-sm">
                    <div class="w-14 h-14 bg-emerald-100 text-emerald-600 rounded-xl flex items-center justify-center mx-auto mb-6 text-2xl">
                        <i class="fas fa-language"></i>
                    </div>
                    <h3 class="text-xl font-bold mb-4">Langues</h3>
                    <p class="text-slate-500 text-sm">Français (Bilingue), Arabe (Maternelle), Anglais (Avancé - B2/C1).</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="py-20 bg-white">
        <div class="max-w-4xl mx-auto px-6">
            <div class="bg-blue-900 rounded-3xl p-8 md:p-12 text-white overflow-hidden relative">
                <div class="absolute top-0 right-0 w-64 h-64 bg-blue-800 rounded-full -mr-32 -mt-32 opacity-50"></div>
                <div class="relative z-10">
                    <h2 class="text-3xl font-bold mb-8">Discutons de votre projet</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div>
                            <p class="text-blue-200 mb-6">Je suis disponible pour un entretien à Rabat ou en visioconférence.</p>
                            <div class="space-y-4">
                                <div class="flex items-center gap-4">
                                    <div class="w-10 h-10 bg-blue-800 rounded-lg flex items-center justify-center">
                                        <i class="fas fa-envelope"></i>
                                    </div>
                                    <span>yasmine.alaoui@email.ma</span>
                                </div>
                                <div class="flex items-center gap-4">
                                    <div class="w-10 h-10 bg-blue-800 rounded-lg flex items-center justify-center">
                                        <i class="fas fa-phone"></i>
                                    </div>
                                    <span>+212 6 XX XX XX XX</span>
                                </div>
                                <div class="flex items-center gap-4">
                                    <div class="w-10 h-10 bg-blue-800 rounded-lg flex items-center justify-center">
                                        <i class="fab fa-linkedin"></i>
                                    </div>
                                    <span>linkedin.com/in/yasmine-mkt</span>
                                </div>
                            </div>
                        </div>
                        <div class="bg-white rounded-2xl p-6 text-slate-900 shadow-xl">
                            <form onsubmit="event.preventDefault(); document.getElementById('success-msg').classList.remove('hidden');">
                                <div class="mb-4">
                                    <label class="block text-sm font-semibold mb-2">Votre Nom</label>
                                    <input type="text" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 outline-none" placeholder="Ex: Agence Digital" required>
                                </div>
                                <div class="mb-4">
                                    <label class="block text-sm font-semibold mb-2">Message</label>
                                    <textarea class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 outline-none h-24" placeholder="Votre proposition de stage..." required></textarea>
                                </div>
                                <button type="submit" class="w-full bg-blue-600 text-white font-bold py-3 rounded-lg hover:bg-blue-700 transition">Envoyer</button>
                                <div id="success-msg" class="hidden mt-4 p-2 bg-green-100 text-green-700 text-sm text-center rounded">
                                    Merci ! Je reviens vers vous rapidement.
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="py-8 text-center text-slate-500 text-sm border-t">
        <p>© 2024 Yasmine Alaoui - Créé pour une recherche de stage à Rabat.</p>
    </footer>

</body>
</html>
